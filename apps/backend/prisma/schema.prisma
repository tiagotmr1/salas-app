generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")

}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum Role {
  ADMIN
  GESTOR
  COLABORADOR
  RECEPCAO
}

enum RoomStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  NO_SHOW
  COMPLETED
}

enum RecurrenceType {
  NONE
  DAILY
  WEEKLY
  MONTHLY
}

// ─────────────────────────────────────────────
// USERS
// ─────────────────────────────────────────────

model User {
  id                 String    @id @default(uuid())
  name               String    @db.VarChar(100)
  email              String    @unique @db.VarChar(255)
  passwordHash       String
  role               Role      @default(COLABORADOR)
  isActive           Boolean   @default(true)
  emailNotifications Boolean   @default(true)
  avatarUrl          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  bookings       Booking[]       @relation("UserBookings")
  guestBookings  BookingGuest[]
  refreshTokens  RefreshToken[]

  @@map("users")
}

// ─────────────────────────────────────────────
// ROOMS
// ─────────────────────────────────────────────

model Room {
  id               String     @id @default(uuid())
  name             String     @unique @db.VarChar(100)
  floor            String?    @db.VarChar(20)
  capacity         Int
  status           RoomStatus @default(ACTIVE)
  description      String?    @db.Text
  photoUrl         String?
  openTime         String?    @db.VarChar(5)  // ex: "08:00"
  closeTime        String?    @db.VarChar(5)  // ex: "20:00"
  requiresApproval Boolean    @default(false)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  resources RoomResource[]
  bookings  Booking[]

  @@map("rooms")
}

// ─────────────────────────────────────────────
// RESOURCES
// ─────────────────────────────────────────────

model Resource {
  id   String @id @default(uuid())
  name String @unique @db.VarChar(100)

  rooms RoomResource[]

  @@map("resources")
}

model RoomResource {
  roomId     String
  resourceId String

  room     Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@id([roomId, resourceId])
  @@map("room_resources")
}

// ─────────────────────────────────────────────
// BOOKINGS
// ─────────────────────────────────────────────

model Booking {
  id                String         @id @default(uuid())
  roomId            String
  userId            String
  title             String         @db.VarChar(200)
  description       String?        @db.Text
  startTime         DateTime
  endTime           DateTime
  status            BookingStatus  @default(CONFIRMED)
  recurrence        RecurrenceType @default(NONE)
  recurrenceGroupId String?
  checkedInAt       DateTime?
  checkedOutAt      DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  room   Room           @relation(fields: [roomId], references: [id])
  user   User           @relation("UserBookings", fields: [userId], references: [id])
  guests BookingGuest[]

  @@index([roomId, startTime, endTime])
  @@index([userId])
  @@map("bookings")
}

model BookingGuest {
  bookingId String
  userId    String
  notified  Boolean @default(false)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([bookingId, userId])
  @@map("booking_guests")
}

// ─────────────────────────────────────────────
// HOLIDAYS
// ─────────────────────────────────────────────

model Holiday {
  id             String   @id @default(uuid())
  date           DateTime @unique @db.Date
  description    String   @db.VarChar(200)
  blocksBooking  Boolean  @default(true)

  @@map("holidays")
}

// ─────────────────────────────────────────────
// REFRESH TOKENS
// ─────────────────────────────────────────────

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}
